# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://career_radar:career_radar@localhost:5432/career_radar
ANTHROPIC_API_KEY=
AI_CHEAP_MODEL=claude-3-5-haiku-latest
AI_CAPABLE_MODEL=claude-sonnet-4-5
# Budgets in micro-USD (1e-6); unset = unlimited
AI_DAILY_BUDGET_MICRO=
AI_MONTHLY_BUDGET_MICRO=
AUTH_JWT_SECRET=
